<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="18dp"
        android:paddingEnd="16dp"
        android:paddingBottom="30dp">

        <!-- ================================================= -->
        <!-- TOPO -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- MENU -->

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="Abrir menu"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_menu"
                android:clickable="true"
                android:focusable="true" />

            <!-- ESPAÇO -->

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- LOGO -->

            <ImageView
                android:id="@+id/logoSobreNos"
                android:layout_width="65dp"
                android:layout_height="58dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="Logo Balance Tech"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_balance" />

            <!-- PERFIL -->

            <ImageButton
                android:id="@+id/btnPerfilSobreNos"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="2dp"
                android:background="@android:color/transparent"
                android:contentDescription="Abrir perfil"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_perfil_home"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- TÍTULO SOBRE NÓS -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- ÍCONE SOBRE NÓS VERDE -->

            <ImageView
                android:id="@+id/imgIconeSobreNos"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="Sobre nós"
                android:scaleType="centerInside"
                android:src="@drawable/ic_sobre_nos_tela" />

            <!-- TÍTULO -->

            <TextView
                android:id="@+id/txtTituloSobreNos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Sobre nós"
                android:textColor="#222222"
                android:textSize="24sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- IDENTIFICAÇÃO -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="NextHealth"
            android:textColor="#57905C"
            android:textSize="12sp"
            android:textStyle="bold" />


        <!-- ================================================= -->
        <!-- DESCRIÇÃO -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/txtSobreDescricao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:lineSpacingExtra="3dp"
            android:text="Somos a equipe 05 da Etec Uirapuru. Nosso objetivo é contribuir para a redução das taxas de obesidade por meio do incentivo a hábitos alimentares mais saudáveis. Utilizando inteligência artificial, o aplicativo auxilia no monitoramento da alimentação, promove escolhas conscientes e incentiva uma melhor qualidade de vida."
            android:textColor="#333333"
            android:textSize="14sp" />


        <!-- ================================================= -->
        <!-- INSTAGRAM -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:gravity="center"
                android:text="◎"
                android:textColor="#D946A8"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtInstagram"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="NextHealth_06"
                android:textColor="#333333"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>