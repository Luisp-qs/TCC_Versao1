<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".HomeActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- TOPO -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnMenu"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@android:color/transparent"
                    android:src="@drawable/ic_menu"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="Menu" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/btnPerfil"
                    android:layout_width="55dp"
                    android:layout_height="55dp"
                    android:background="@android:color/transparent"
                    android:src="@drawable/logo_balance"
                    android:scaleType="fitCenter"
                    android:contentDescription="Logo Balance Tech" />

            </LinearLayout>

            <!-- ATALHOS -->

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/btnHistorico"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:background="@drawable/button_background"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="9dp"
                        android:paddingEnd="9dp"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_historico"
                            android:scaleType="fitCenter"
                            android:contentDescription="Histórico" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="Histórico"
                            android:textColor="#333333"
                            android:textSize="11sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnEvolucao"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="5dp"
                        android:background="@drawable/button_background"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="9dp"
                        android:paddingEnd="9dp"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_evolucao"
                            android:scaleType="fitCenter"
                            android:contentDescription="Evolução" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="Evolução"
                            android:textColor="#333333"
                            android:textSize="11sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnMontePrato"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="5dp"
                        android:background="@drawable/button_background"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="9dp"
                        android:paddingEnd="9dp"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_monte_prato"
                            android:scaleType="fitCenter"
                            android:contentDescription="Monte seu Prato" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="Monte seu Prato"
                            android:textColor="#333333"
                            android:textSize="11sp" />

                    </LinearLayout>

                </LinearLayout>

            </HorizontalScrollView>

            <Space
                android:layout_width="match_parent"
                android:layout_height="12dp" />

            <!-- BANNER -->

            <ImageView
                android:id="@+id/imgBanner"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:scaleType="centerCrop"
                android:src="@drawable/banner_home"
                android:contentDescription="Banner Balance Tech" />

            <!-- CALORIAS -->

            <TextView
                android:id="@+id/txtHoje"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Hoje"
                android:textColor="#333333"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtCalorias"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Consumir 2.100 Kcal"
                android:textColor="#555555"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/txtConsumidas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.600 Consumidas"
                android:textColor="#555555"
                android:textSize="11sp" />

            <ProgressBar
                android:id="@+id/progressCalorias"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="5dp"
                android:max="2100"
                android:progress="1600"
                android:progressTint="#57905C"
                android:backgroundTint="#CCCCCC" />

            <!-- MACROS -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:padding="8dp"
                    android:orientation="vertical"
                    android:background="@drawable/card_background">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Carbs"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#333333" />

                    <TextView
                        android:id="@+id/txtCarboidratos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="211/349g"
                        android:textSize="10sp"
                        android:textColor="#555555" />

                    <ProgressBar
                        android:id="@+id/progressCarbs"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="7dp"
                        android:layout_marginTop="8dp"
                        android:max="349"
                        android:progress="211"
                        android:progressTint="#E8A4C4" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:padding="8dp"
                    android:orientation="vertical"
                    android:background="@drawable/card_background">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Proteína"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#333333" />

                    <TextView
                        android:id="@+id/txtProteina"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="143/209g"
                        android:textSize="10sp"
                        android:textColor="#555555" />

                    <ProgressBar
                        android:id="@+id/progressProteina"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="7dp"
                        android:layout_marginTop="8dp"
                        android:max="209"
                        android:progress="143"
                        android:progressTint="#D58CC2" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:padding="8dp"
                    android:orientation="vertical"
                    android:background="@drawable/card_background">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gordura"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#333333" />

                    <TextView
                        android:id="@+id/txtGordura"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="108/175g"
                        android:textSize="10sp"
                        android:textColor="#555555" />

                    <ProgressBar
                        android:id="@+id/progressGordura"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="7dp"
                        android:layout_marginTop="8dp"
                        android:max="175"
                        android:progress="108"
                        android:progressTint="#9FC6E8" />

                </LinearLayout>

            </LinearLayout>

            <!-- CARDS -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/cardJejum"
                    android:layout_width="0dp"
                    android:layout_height="145dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="110dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/jejum"
                        android:contentDescription="O que é jejum" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="35dp"
                        android:text="O que é jejum?"
                        android:textSize="10sp"
                        android:gravity="center_vertical"
                        android:textColor="#333333" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cardMassaMagra"
                    android:layout_width="0dp"
                    android:layout_height="145dp"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="110dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/massa_magra"
                        android:contentDescription="Ganho de massa magra" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="35dp"
                        android:text="Ganho de massa magra"
                        android:textSize="10sp"
                        android:gravity="center_vertical"
                        android:textColor="#333333" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>